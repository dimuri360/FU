<Window x:Class="EinstellungenApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einfacher Taschenrechner" Height="420" Width="320"
        ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F1F1F" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <TextBlock x:Name="DisplayText"
                       Text="0"
                       FontSize="36"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right" />
        </Border>

        <Grid Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="C" Padding="12"
                    Click="ClearButton_Click" />
            <Button Grid.Row="0" Grid.Column="1" Content="CE" Padding="12"
                    Click="ClearEntryButton_Click" />
            <Button Grid.Row="0" Grid.Column="2" Content="±" Padding="12"
                    Click="SignToggleButton_Click" />
            <Button Grid.Row="0" Grid.Column="3" Content="÷" Padding="12"
                    Click="OperationButton_Click" Tag="/" />

            <Button Grid.Row="1" Grid.Column="0" Content="7" Padding="12"
                    Click="DigitButton_Click" Tag="7" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Padding="12"
                    Click="DigitButton_Click" Tag="8" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Padding="12"
                    Click="DigitButton_Click" Tag="9" />
            <Button Grid.Row="1" Grid.Column="3" Content="×" Padding="12"
                    Click="OperationButton_Click" Tag="*" />

            <Button Grid.Row="2" Grid.Column="0" Content="4" Padding="12"
                    Click="DigitButton_Click" Tag="4" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Padding="12"
                    Click="DigitButton_Click" Tag="5" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Padding="12"
                    Click="DigitButton_Click" Tag="6" />
            <Button Grid.Row="2" Grid.Column="3" Content="-" Padding="12"
                    Click="OperationButton_Click" Tag="-" />

            <Button Grid.Row="3" Grid.Column="0" Content="1" Padding="12"
                    Click="DigitButton_Click" Tag="1" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Padding="12"
                    Click="DigitButton_Click" Tag="2" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Padding="12"
                    Click="DigitButton_Click" Tag="3" />
            <Button Grid.Row="3" Grid.Column="3" Content="+" Padding="12"
                    Click="OperationButton_Click" Tag="+" />

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Padding="12"
                    Click="DigitButton_Click" Tag="0" />
            <Button x:Name="DecimalButton" Grid.Row="4" Grid.Column="2" Content="," Padding="12"
                    Click="DecimalButton_Click" />
            <Button Grid.Row="4" Grid.Column="3" Content="=" Padding="12"
                    Click="EqualsButton_Click" />
        </Grid>
    </Grid>
</Window>
